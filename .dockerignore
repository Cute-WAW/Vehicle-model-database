# 忽略版本控制和IDE配置
.git
.gitignore
.vscode
.idea
.DS_Store

# 忽略虚拟环境
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd

# 忽略日志和临时文件
*.log
*.tmp
temp/

# 忽略不需要打包进镜像的大型数据文件
# 注意：我们通过 volume 挂载 output 目录，所以构建时不需要 COPY 进去
# 除非你的代码强依赖镜像内必须有这些文件才能启动（通常不建议）
output/
data/
*.db
*.sqlite
# 保留必要的配置文件
!output/brand_series_models/
!output/car_types_models/