.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
  box-sizing: border-box;
}

.header-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

.avatar-area {
  margin-right: 30rpx;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  background-color: #e0e0e0;
  border-radius: 60rpx;
  font-size: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.user-id {
  font-size: 24rpx;
  color: #888888;
}

.status-panel {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
}

.panel-header {
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eeeeee;
  padding-bottom: 20rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.status-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}

.status-item:last-child {
  border-bottom: none;
  flex-direction: column;
  align-items: flex-start;
}

.item-label {
  font-size: 28rpx;
  color: #666666;
}

.item-value {
  font-size: 28rpx;
  font-weight: 500;
}

.text-green { color: #07c160; }
.text-gray { color: #999999; }

.token-container {
  margin-top: 10rpx;
  background-color: #f9f9f9;
  padding: 16rpx;
  border-radius: 8rpx;
  word-break: break-all;
  width: 100%;
  box-sizing: border-box;
}

.token-text {
  font-size: 22rpx;
  color: #abaaaa;
  font-family: monospace;
}

.action-area {
  margin-top: auto; /* Push down to bottom if container has height */
  margin-bottom: 60rpx;
}

.btn-login {
  background-color: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
}

.btn-logout {
  background-color: #ffffff;
  color: #e64340;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  border: 1rpx solid #ffcccc;
}

.btn-logout::after { border: none; }
