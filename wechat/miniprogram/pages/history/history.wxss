.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.count {
  font-size: 26rpx;
  color: #999;
}

.list-item {
  display: flex;
  align-items: center;
  background: #fff;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.item-main {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.item-info {
  margin-bottom: 8rpx;
}

.item-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #4CAF50;
}

.item-range {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.item-date {
  font-size: 24rpx;
  color: #bbb;
}

.delete-btn {
  color: #f44336;
  font-size: 26rpx;
  padding: 10rpx 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 10rpx;
}
