<view class="container" wx:if="{{result}}">
  <!-- 车辆信息 -->
  <view class="vehicle-header">
    <text class="vehicle-name">{{vehicleName}}</text>
  </view>

  <!-- 价格卡片 -->
  <view class="card price-card">
    <view class="price-display">
      <text class="price-label">💰 预估价格</text>
      <view class="price-main">
        <text class="price-value">{{result.predicted_price}}</text>
        <text class="price-unit">万元</text>
      </view>
      <text class="price-range">建议区间: {{result.price_range.low}} - {{result.price_range.high}} 万元</text>
    </view>
  </view>

  <!-- 价格解释 -->
  <view class="card" wx:if="{{result.explanation}}">
    <view class="card-title">📊 价格解释</view>
    <text class="summary">{{result.explanation.summary}}</text>
    
    <!-- 置信度 -->
    <view class="confidence">
      <text>置信度: </text>
      <text class="confidence-value {{result.explanation.confidence}}">
        {{result.explanation.confidence === 'high' ? '⭐⭐⭐ 高' : result.explanation.confidence === 'medium' ? '⭐⭐ 中' : '⭐ 低'}}
      </text>
    </view>

    <!-- 影响因素 -->
    <view class="factors" wx:if="{{result.explanation.factors.length > 0}}">
      <view class="factor-title">🔍 影响因素</view>
      <view class="factor-item" wx:for="{{result.explanation.factors}}" wx:key="name">
        <view class="factor-label">
          <text class="factor-name">{{item.label}}</text>
          <text class="factor-reason">{{item.reason}}</text>
        </view>
        <text class="factor-delta {{item.delta >= 0 ? 'positive' : 'negative'}}">
          {{item.delta >= 0 ? '+' : ''}}{{item.delta}}万
        </text>
      </view>
    </view>
  </view>



  <!-- 相似成交 -->
  <view class="card" wx:if="{{result.similar_vehicles && result.similar_vehicles.length > 0}}">
    <view class="card-title">📉 相似成交 (Top 10)</view>
    <view class="similar-list">
      <view class="similar-item" wx:for="{{result.similar_vehicles}}" wx:key="index">
        <view class="similar-row-top">
          <text class="similar-name">{{item.vehicle_full_name}}</text>
          <text class="similar-price">{{item.used_price}}万</text>
        </view>
        <view class="similar-row-bottom">
          <text class="similar-info">{{item.reg_date_str}} | {{item.mileage}}万公里 | {{item.city}} | {{item.grade}}</text>
          <view class="similar-tag">相似度 {{item.score}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="button-area">
    <button class="btn-primary" bindtap="onCopy">📋 复制结果</button>
    <button class="btn-secondary" bindtap="onRetry">🔄 重新估价</button>
  </view>
</view>

<view class="empty-state" wx:else>
  <text class="icon">😕</text>
  <text>暂无结果</text>
  <button class="btn-secondary" bindtap="onGoHome">返回首页</button>
</view>
