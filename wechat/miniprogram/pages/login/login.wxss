.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  box-sizing: border-box;
  background-color: #ffffff;
  padding: 40rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  background-color: #f0fdf4;
  border-radius: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
}

.logo-text {
  font-size: 80rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888888;
}

.btn-area {
  width: 100%;
}

.btn-primary {
  background-color: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-bottom: 30rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666666;
  font-size: 32rpx;
  border-radius: 12rpx;
  padding: 24rpx 0;
}

.btn-cancel::after {
  border: none;
}
